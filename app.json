{
  "expo": {
    "name": "musica",
    "slug": "musica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/musicac.png",
    "scheme": "musica",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/musicac.png",
        "backgroundImage": "./assets/images/musicac.png",
        "monochromeImage": "./assets/images/musicac.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.marcelojealopes.musica"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/musicac.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/musicac.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d15126b6-9cbc-44ff-a3ba-ab2071fc4b2c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d15126b6-9cbc-44ff-a3ba-ab2071fc4b2c"
    }
  }
}
